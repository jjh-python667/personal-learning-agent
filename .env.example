DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# At least 16 characters. This is the admin web password (username: admin).
# Required for access outside localhost. Do not commit the real value.
APP_PASSWORD=
# Optional QQ official SDK bridge. QQ stays single-owner; classmates use the web invite.
QQ_APP_ID=
QQ_APP_SECRET=
QQ_OWNER_OPENID=
# Per user, per day. Chat, quiz grading and "continue task" each count once.
# Listing documents does not. 0 means no model calls.
AI_DAILY_QUOTA=40
# Minimum seconds between two AI requests for the same user. 0 disables it.
# If this variable is missing or empty, the program also uses 0.
# The number on the next line applies after this file is copied to .env.
# This gap is kept in memory and resets when the process restarts.
AI_MIN_INTERVAL_SECONDS=3
# How many AI requests may run at the same time, for everyone / for one user.
AI_MAX_CONCURRENCY=2
AI_USER_CONCURRENCY=1
# Upload size limit in bytes. 12582912 = 12MB.
MAX_UPLOAD_BYTES=12582912
# Public https origin used in invite links, for example https://study.example.com
# Leave empty to build the link from the browser address. No trailing slash.
PUBLIC_BASE_URL=
